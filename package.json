{
  "name": "@local/kadda-rules",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Work rules plus a staged development workflow: prompt sections, /dev /verify /review commands, and plan/stop gates.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syncaus/local-kadda-rules.git"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "rules/*.md",
    "guides/*.md",
    "flow/*.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
